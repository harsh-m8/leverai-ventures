# ─── App ──────────────────────────────────────────────────────────
# Full public URL of this deployment (no trailing slash).
# Used to build OAuth redirect URIs.
NEXT_PUBLIC_APP_URL=https://leveraiventures.com

# ─── Supabase ─────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ─── Resend (transactional email) ─────────────────────────────────
# 1. Sign up at https://resend.com and get an API key.
# 2. In Supabase Dashboard → Auth → SMTP Settings, configure:
#      Host:     smtp.resend.com
#      Port:     465
#      Username: resend
#      Password: <your Resend API key>
#      Sender:   noreply@yourdomain.com
# No code changes needed — Supabase Auth calls Resend directly.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ─── Meta (Facebook) Ads ──────────────────────────────────────────
# Create an app at https://developers.facebook.com/
# Add product: "Marketing API"
# Callback URL to whitelist: https://your-app.azurewebsites.net/api/integrations/meta/callback
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# ─── Google Ads ───────────────────────────────────────────────────
# Create OAuth credentials at https://console.cloud.google.com/
# Authorised redirect URI: https://your-app.azurewebsites.net/api/integrations/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Apply for a developer token at:
# https://developers.google.com/google-ads/api/docs/get-started/dev-token
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token

# Optional: Google Ads Manager (MCC) account ID
GOOGLE_ADS_MANAGER_CUSTOMER_ID=

# ─── Shopify / Klaviyo ────────────────────────────────────────────
# No server-side secrets needed — customers supply their own
# credentials through the Integrations UI.
